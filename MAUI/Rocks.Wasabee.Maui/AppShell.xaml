<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="Rocks.Wasabee.Maui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Rocks.Wasabee.Maui.Views"
    FlyoutBehavior="Disabled">

    <ShellContent Title="Login" ContentTemplate="{DataTemplate views:LoginPage}" Route="login" />

    <TabBar>
        <ShellContent Title="Home" ContentTemplate="{DataTemplate views:MainPage}" Route="main" />
        <ShellContent Title="Map" ContentTemplate="{DataTemplate views:MainPage}" Route="map" />
    </TabBar>

</Shell>
