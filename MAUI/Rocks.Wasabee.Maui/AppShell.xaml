       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:views="clr-namespace:Rocks.Wasabee.Maui.Views"
       FlyoutBehavior="Disabled">

    <ShellContent ContentTemplate="{DataTemplate views:LoginPage}" Route="LoginPage" />

    <TabBar Route="Root">
        <ShellContent Title="Map" ContentTemplate="{DataTemplate views:OperationMapPage}" Route="OperationMapPage" />
    </TabBar>

</Shell>
