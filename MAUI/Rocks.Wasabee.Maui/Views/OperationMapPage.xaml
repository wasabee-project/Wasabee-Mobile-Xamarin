<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:views="clr-namespace:Rocks.Wasabee.Maui.Views"
                       xmlns:viewModels="clr-namespace:Rocks.Wasabee.Core.ViewModels;assembly=Rocks.Wasabee.Core"
                       xmlns:maps="http://schemas.microsoft.com/dotnet/2021/maui/maps"
                       x:Class="Rocks.Wasabee.Maui.Views.OperationMapPage"
                       x:TypeArguments="viewModels:OperationMapViewModel"
                       BackgroundColor="{DynamicResource BackgroundColorLevel0}">

    <ContentPage.Content>
        <StackLayout>

            <maps:Map MapType="Street" x:Name="Map" />

        </StackLayout>
    </ContentPage.Content>
    
</views:BaseContentPage>