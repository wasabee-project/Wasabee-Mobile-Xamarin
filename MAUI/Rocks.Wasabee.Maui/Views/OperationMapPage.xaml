<?xml version="1.0" encoding="utf-8" ?>
<views:BaseContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                       xmlns:views="clr-namespace:Rocks.Wasabee.Maui.Views"
                       xmlns:viewModels="clr-namespace:Rocks.Wasabee.Core.ViewModels.Operation;assembly=Rocks.Wasabee.Core"
                       xmlns:googleMaps="clr-namespace:Maui.GoogleMaps;assembly=Maui.GoogleMaps"
                       x:Class="Rocks.Wasabee.Maui.Views.OperationMapPage"
                       x:TypeArguments="viewModels:OperationMapViewModel"
                       x:DataType="viewModels:OperationMapViewModel"
                       BackgroundColor="{DynamicResource BackgroundColorLevel0}">

    <ContentPage.Content>
        <googleMaps:Map MapType="Street" x:Name="Map" />
    </ContentPage.Content>
    
</views:BaseContentPage>