<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:Rocks.Wasabee.Core.ViewModels;assembly=Rocks.Wasabee.Core"
             xmlns:xaml="clr-namespace:Rocks.Wasabee.Maui.Core.Helpers.Xaml;assembly=Rocks.Wasabee.Maui.Core"
             xmlns:models="clr-namespace:Rocks.Wasabee.Core.Models;assembly=Rocks.Wasabee.Core"
             xmlns:converters="clr-namespace:Rocks.Wasabee.Maui.Core.Helpers.Converters;assembly=Rocks.Wasabee.Maui.Core"
             x:Class="Rocks.Wasabee.Maui.Views.LoginPage"
             x:DataType="viewModels:LoginPageViewModel"
             Title="">

    <ContentPage.Resources>
        <converters:BoolNegateConverter x:Key="BoolNegateConverter" />
    </ContentPage.Resources>

    <ContentPage.Content>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <VerticalStackLayout Grid.Row="0" 
                                 Padding="0,100,0,0" 
                                 Spacing="50">

                <Image HeightRequest="50"
                       Source="wasabee.png" />

                <Label x:Name="TitleLabel"
                       Text="Wasabee"
                       HorizontalTextAlignment="Center"
                       FontSize="35" />

            </VerticalStackLayout>

            <VerticalStackLayout Grid.Row="1" 
                                 VerticalOptions="Center"
                                 Padding="20,0">

                <!-- Loader and login step -->
                <VerticalStackLayout IsVisible="{Binding IsLoading}">
                    <ActivityIndicator Color="{DynamicResource PrimaryGreen}"
                                           IsRunning="True"
                                           HeightRequest="80"/>
                    <Label HorizontalTextAlignment="Center"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="CenterAndExpand"
                           Text="{Binding LoadingStepLabel}"/>
                </VerticalStackLayout>


                <!-- Login buttons -->
                <Grid IsVisible="{Binding IsLoginVisible}">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="45" />
                        <RowDefinition Height="65" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            BackgroundColor="{DynamicResource GoogleSignInBlue}"
                            StrokeShape="RoundRectangle 2"
                            IsVisible="{Binding IsGButtonVisible}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                            </Grid.RowDefinitions>

                            <Border Grid.Column="0" Grid.Row="0" Margin="0" Padding="0"
                                    StrokeShape="RoundRectangle 2"
                                    BackgroundColor="White" HeightRequest="50" WidthRequest="50">
                                <Image Source="g_logo.png" HeightRequest="24" WidthRequest="24" />
                            </Border>

                            <Label Text="{xaml:Translate SignIn_Button_WithGoogle}" Grid.Column="1" Grid.Row="0" Margin="30, 5"
                                   VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"
                                   FontSize="18" TextColor="White" FontAttributes="Bold" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ConnectUserCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            BackgroundColor="{DynamicResource PrimaryGreen}"
                            StrokeShape="RoundRectangle 2"
                            IsVisible="{Binding IsOTTButtonVisible}"
                            Margin="0,10,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="50" />
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="50" />
                            </Grid.RowDefinitions>

                            <Border Grid.Column="0" Grid.Row="0" Margin="0" Padding="0"
                                    StrokeShape="RoundRectangle 2"
                                    BackgroundColor="White" HeightRequest="50" WidthRequest="50">
                                <Image Source="wasabee.png" HeightRequest="24" WidthRequest="24" />
                            </Border>

                            <Label Text="{xaml:Translate SignIn_Button_OneTimeToken}" Grid.Column="1" Grid.Row="0" Margin="30, 5"
                                   VerticalOptions="CenterAndExpand" HorizontalOptions="CenterAndExpand"
                                   FontSize="18" TextColor="White" FontAttributes="Bold" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding UseOneTimeTokenCommand}" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>

                    <Label Grid.Row="2"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding IsAuthInError}"
                           Text="{Binding ErrorMessage}"
                           Margin="0, 20, 0, 0"
                           TextColor="{DynamicResource AccentColor}" />

                    <Label Grid.Row="3"
                           HorizontalTextAlignment="Center"
                           IsVisible="{Binding IsConnected, Converter={StaticResource BoolNegateConverter}}"
                           Text="{xaml:Translate SignIn_Label_NoInternet}"
                           Margin="0, 20, 0, 0"
                           TextColor="{DynamicResource AccentColor}" />

                </Grid>

                <!-- One Time Token input -->
                <VerticalStackLayout IsVisible="{Binding IsEnteringToken}" Spacing="10">
                    <Label HorizontalTextAlignment="Center"
                           Text="{xaml:Translate SignIn_Label_EnterToken}"
                           FontSize="18" />

                    <Border StrokeShape="RoundRectangle 5"
                            Stroke="{DynamicResource PrimaryGreen}"
                            Padding="10,0">
                        <Entry Style="{DynamicResource WasabeeStyleEntryText}"
                               Text="{Binding OneTimeToken}"
                               FontSize="18"
                               FontFamily="SpaceMonoRegular"/>
                    </Border>

                    <HorizontalStackLayout Spacing="40" HorizontalOptions="Center">
                        <Button Style="{DynamicResource WasabeeStyleSecondaryActionButton}"
                                Command="{Binding CancelOneTimeTokenCommand}"
                                Text="{xaml:Translate SignIn_Button_Cancel}"
                                FontSize="18"/>

                        <Button Style="{DynamicResource WasabeeStyleMainActionButton}"
                                Command="{Binding ValidateOneTimeTokenCommand}"
                                Text="{xaml:Translate SignIn_Button_Validate}"
                                FontSize="18"/>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- Server selection -->
                <VerticalStackLayout IsVisible="{Binding IsSelectingServer}"
                                     Spacing="20">

                    <Label HorizontalTextAlignment="Center"
                           HorizontalOptions="FillAndExpand"
                           VerticalOptions="CenterAndExpand"
                           Text="{Binding LoadingStepLabel}"
                           FontSize="Large"/>

                    <StackLayout Orientation="Horizontal" HorizontalOptions="CenterAndExpand">
                        <CheckBox Color="{DynamicResource PrimaryGreen}" IsChecked="{Binding RememberServerChoice}"/>
                        <Label Text="{xaml:Translate SignIn_Label_RememberServerChoice}" VerticalOptions="CenterAndExpand" FontSize="Small">
                            <Label.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding RememberChoiceCommand}"/>
                            </Label.GestureRecognizers>
                        </Label>
                    </StackLayout>

                    <CollectionView x:Name="ServerListView" ItemsSource="{Binding ServersCollection}" 
                                    SelectionMode="Single" 
                                    VerticalScrollBarVisibility="Never"
                                    SelectionChanged="ServerListView_OnSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ServerItem">
                                <Border BackgroundColor="{DynamicResource BackgroundColorLevel1}" Margin="0,2" Padding="0"
                                        HorizontalOptions="CenterAndExpand" 
                                        VerticalOptions="CenterAndExpand"
                                        StrokeShape="RoundRectangle 10">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="60" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="62" />
                                        </Grid.RowDefinitions>

                                        <Image Grid.Column="1" Grid.Row="0"
                                               Source="{Binding Image}" />

                                        <Label Grid.Column="2" Grid.Row="0"
                                               Text="{Binding Name}" FontSize="18"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- No team or OPS assigned section -->
                <VerticalStackLayout IsVisible="{Binding HasNoTeamOrOpsAssigned}">

                    <Label HorizontalTextAlignment="Center"
                           Margin="0, 20, 0, 0"
                           TextColor="{DynamicResource AccentColor}"
                           FontSize="Medium"
                           Text="{xaml:Translate SignIn_Label_Warning}"/>

                    <Label HorizontalTextAlignment="Center"
                           Margin="0, 20, 0, 0"
                           TextColor="{DynamicResource AccentColor}"
                           FontSize="Medium"
                           Text="{xaml:Translate SignIn_Label_NoTeamsOrOperation}"/>

                    <Button Margin="0, 30, 0, 0" Text="{xaml:Translate SignIn_Button_ChangeAccount}" Style="{DynamicResource WasabeeStyleCancelButton}" Command="{Binding ChangeAccountCommand}" />
                    <Button Text="{xaml:Translate SignIn_Button_ChangeServer}" Style="{DynamicResource WasabeeStyleCancelButton}" Command="{Binding ChangeServerCommand}" />
                    <Button Text="{xaml:Translate SignIn_Button_Retry}" Style="{DynamicResource WasabeeStyleValidateButton}" Command="{Binding RetryTeamLoadingCommand}" />

                </VerticalStackLayout>

            </VerticalStackLayout>

            <!-- Version number {Binding AppEnvironnement, Converter={StaticResource EnvironnementToColorConverter}} -->
            <StackLayout Grid.Row="2" HeightRequest="40"
                         BackgroundColor="{DynamicResource PrimaryGreenDark}">
                <Label HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       VerticalOptions="CenterAndExpand"
                       Text="2.0.0"
                       TextColor="White">
                    <!-- {Binding DisplayVersion, Mode=OneWay} -->
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding VersionTappedCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </StackLayout>

        </Grid>

    </ContentPage.Content>
</ContentPage>